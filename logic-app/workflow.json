{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "sharePointSiteUrl": {
      "defaultValue": "https://yourtenant.sharepoint.com/sites/AttendanceTracking",
      "type": "String"
    },
    "employeeMasterListName": {
      "defaultValue": "EmployeeMaster",
      "type": "String"
    },
    "dailyAttendanceListName": {
      "defaultValue": "DailyAttendance",
      "type": "String"
    },
    "officeTransfersListName": {
      "defaultValue": "OfficeTransfers",
      "type": "String"
    }
  },
  "triggers": {
    "Daily_Schedule": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "schedule": {
          "hours": [
            "0"
          ],
          "minutes": [
            0
          ]
        },
        "timeZone": "UTC"
      }
    }
  },
  "actions": {
    "Initialize_Today_Date": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "TodayDate",
            "type": "string",
            "value": "@{formatDateTime(utcNow(), 'yyyy-MM-dd')}"
          }
        ]
      },
      "runAfter": {}
    },
    "Initialize_Error_Count": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ErrorCount",
            "type": "integer",
            "value": 0
          }
        ]
      },
      "runAfter": {
        "Initialize_Today_Date": [
          "Succeeded"
        ]
      }
    },
    "Get_Active_Employees": {
      "type": "ApiConnection",
      "inputs": {
        "host": {
          "connection": {
            "name": "@parameters('$connections')['sharepointonline']['connectionId']"
          }
        },
        "method": "get",
        "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('employeeMasterListName')))}/items",
        "queries": {
          "$filter": "CurrentStatus eq 'Active'",
          "$orderby": "EmployeeID"
        }
      },
      "runAfter": {
        "Initialize_Error_Count": [
          "Succeeded"
        ]
      },
      "runtimeConfiguration": {
        "paginationPolicy": {
          "minimumItemCount": 100000
        }
      }
    },
    "Get_Active_Transfers": {
      "type": "ApiConnection",
      "inputs": {
        "host": {
          "connection": {
            "name": "@parameters('$connections')['sharepointonline']['connectionId']"
          }
        },
        "method": "get",
        "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('officeTransfersListName')))}/items",
        "queries": {
          "$filter": "TransferStatus eq 'Active' and StartDate le '@{variables('TodayDate')}' and (EndDate eq null or EndDate ge '@{variables('TodayDate')}')"
        }
      },
      "runAfter": {
        "Get_Active_Employees": [
          "Succeeded"
        ]
      }
    },
    "Create_Transfer_Lookup": {
      "type": "ParseJson",
      "inputs": {
        "content": "@body('Get_Active_Transfers')?['value']",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "EmployeeID": {
                "type": "string"
              },
              "ToOffice": {
                "type": "string"
              }
            }
          }
        }
      },
      "runAfter": {
        "Get_Active_Transfers": [
          "Succeeded"
        ]
      }
    },
    "For_Each_Employee": {
      "type": "Foreach",
      "foreach": "@body('Get_Active_Employees')?['value']",
      "actions": {
        "Get_Employee_Transfer": {
          "type": "Query",
          "inputs": {
            "from": "@body('Create_Transfer_Lookup')",
            "where": "@equals(item()?['EmployeeID'], items('For_Each_Employee')?['EmployeeID'])"
          },
          "runAfter": {}
        },
        "Set_Assigned_Office": {
          "type": "Compose",
          "inputs": "@if(greater(length(body('Get_Employee_Transfer')), 0), first(body('Get_Employee_Transfer'))?['ToOffice'], items('For_Each_Employee')?['PrimaryOffice'])",
          "runAfter": {
            "Get_Employee_Transfer": [
              "Succeeded"
            ]
          }
        },
        "Create_Attendance_Record": {
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
              }
            },
            "method": "post",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('dailyAttendanceListName')))}/items",
            "body": {
              "Date": "@variables('TodayDate')",
              "EmployeeID": "@items('For_Each_Employee')?['EmployeeID']",
              "EmployeeName": "@items('For_Each_Employee')?['EmployeeName']",
              "AssignedOffice": "@outputs('Set_Assigned_Office')",
              "AttendanceStatus": "Pending"
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 4,
              "interval": "PT10S",
              "minimumInterval": "PT5S",
              "maximumInterval": "PT1H"
            }
          },
          "runAfter": {
            "Set_Assigned_Office": [
              "Succeeded"
            ]
          }
        },
        "Handle_Create_Error": {
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@outputs('Create_Attendance_Record')['statusCode']",
                  200
                ]
              }
            ]
          },
          "actions": {},
          "else": {
            "actions": {
              "Increment_Error_Count": {
                "type": "IncrementVariable",
                "inputs": {
                  "name": "ErrorCount",
                  "value": 1
                },
                "runAfter": {}
              },
              "Log_Error": {
                "type": "Compose",
                "inputs": {
                  "ErrorType": "CreateAttendanceRecordFailed",
                  "EmployeeID": "@items('For_Each_Employee')?['EmployeeID']",
                  "EmployeeName": "@items('For_Each_Employee')?['EmployeeName']",
                  "Timestamp": "@utcNow()",
                  "ErrorDetails": "@body('Create_Attendance_Record')"
                },
                "runAfter": {
                  "Increment_Error_Count": [
                    "Succeeded"
                  ]
                }
              }
            }
          },
          "runAfter": {
            "Create_Attendance_Record": [
              "Succeeded",
              "Failed",
              "TimedOut"
            ]
          }
        }
      },
      "runAfter": {
        "Create_Transfer_Lookup": [
          "Succeeded"
        ]
      },
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 20
        }
      }
    },
    "Check_For_Errors": {
      "type": "If",
      "expression": {
        "and": [
          {
            "greater": [
              "@variables('ErrorCount')",
              0
            ]
          }
        ]
      },
      "actions": {
        "Send_Error_Notification": {
          "type": "Compose",
          "inputs": {
            "Subject": "Daily Attendance Generation - Errors Occurred",
            "Body": "The daily attendance generation process completed with @{variables('ErrorCount')} errors. Please check the logs for details.",
            "Timestamp": "@utcNow()",
            "Date": "@variables('TodayDate')"
          },
          "runAfter": {}
        }
      },
      "else": {
        "actions": {
          "Send_Success_Notification": {
            "type": "Compose",
            "inputs": {
              "Subject": "Daily Attendance Generation - Success",
              "Body": "Daily attendance records have been successfully generated for @{variables('TodayDate')}.",
              "TotalRecords": "@length(body('Get_Active_Employees')?['value'])",
              "Timestamp": "@utcNow()"
            },
            "runAfter": {}
          }
        }
      },
      "runAfter": {
        "For_Each_Employee": [
          "Succeeded",
          "Failed",
          "Skipped",
          "TimedOut"
        ]
      }
    },
    "Update_Expired_Transfers": {
      "type": "Scope",
      "actions": {
        "Get_Expired_Transfers": {
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
              }
            },
            "method": "get",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('officeTransfersListName')))}/items",
            "queries": {
              "$filter": "TransferStatus eq 'Active' and EndDate lt '@{variables('TodayDate')}'"
            }
          },
          "runAfter": {}
        },
        "For_Each_Expired_Transfer": {
          "type": "Foreach",
          "foreach": "@body('Get_Expired_Transfers')?['value']",
          "actions": {
            "Update_Transfer_Status": {
              "type": "ApiConnection",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['sharepointonline']['connectionId']"
                  }
                },
                "method": "patch",
                "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('officeTransfersListName')))}/items/@{items('For_Each_Expired_Transfer')?['ID']}",
                "body": {
                  "TransferStatus": "Completed"
                }
              },
              "runAfter": {}
            }
          },
          "runAfter": {
            "Get_Expired_Transfers": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Check_For_Errors": [
          "Succeeded"
        ]
      }
    }
  },
  "outputs": {
    "ProcessingSummary": {
      "type": "Object",
      "value": {
        "Date": "@variables('TodayDate')",
        "TotalEmployees": "@length(body('Get_Active_Employees')?['value'])",
        "ActiveTransfers": "@length(body('Get_Active_Transfers')?['value'])",
        "ErrorCount": "@variables('ErrorCount')",
        "CompletedAt": "@utcNow()"
      }
    }
  }
}
