{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "sharePointSiteUrl": {
      "defaultValue": "https://yourtenant.sharepoint.com/sites/AttendanceTracking",
      "type": "String"
    },
    "employeeMasterListName": {
      "defaultValue": "EmployeeMaster",
      "type": "String"
    },
    "dailyAttendanceListName": {
      "defaultValue": "DailyAttendance",
      "type": "String"
    },
    "exportDocumentLibrary": {
      "defaultValue": "AttendanceExports",
      "type": "String"
    },
    "exportFolderPath": {
      "defaultValue": "/AttendanceExports",
      "type": "String"
    }
  },
  "triggers": {
    "Daily_Export_Schedule": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "schedule": {
          "hours": [
            "23"
          ],
          "minutes": [
            0
          ]
        },
        "timeZone": "UTC"
      }
    }
  },
  "actions": {
    "Initialize_Export_Date": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ExportDate",
            "type": "string",
            "value": "@{formatDateTime(utcNow(), 'yyyy-MM-dd')}"
          }
        ]
      },
      "runAfter": {}
    },
    "Initialize_Export_Timestamp": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "ExportTimestamp",
            "type": "string",
            "value": "@{formatDateTime(utcNow(), 'yyyyMMdd_HHmmss')}"
          }
        ]
      },
      "runAfter": {
        "Initialize_Export_Date": [
          "Succeeded"
        ]
      }
    },
    "Initialize_Items_Array": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "AttendanceItems",
            "type": "array",
            "value": []
          }
        ]
      },
      "runAfter": {
        "Initialize_Export_Timestamp": [
          "Succeeded"
        ]
      }
    },
    "Get_Todays_Attendance_Records": {
      "type": "ApiConnection",
      "inputs": {
        "host": {
          "connection": {
            "name": "@parameters('$connections')['sharepointonline']['connectionId']"
          }
        },
        "method": "get",
        "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('dailyAttendanceListName')))}/items",
        "queries": {
          "$filter": "Date eq datetime'@{variables('ExportDate')}'",
          "$orderby": "EmployeeID"
        }
      },
      "runAfter": {
        "Initialize_Items_Array": [
          "Succeeded"
        ]
      },
      "runtimeConfiguration": {
        "paginationPolicy": {
          "minimumItemCount": 100000
        }
      }
    },
    "Check_If_Records_Exist": {
      "type": "If",
      "expression": {
        "and": [
          {
            "greater": [
              "@length(body('Get_Todays_Attendance_Records')?['value'])",
              0
            ]
          }
        ]
      },
      "actions": {
        "Convert_To_Parquet_Format": {
          "type": "Compose",
          "inputs": {
            "metadata": {
              "schema": {
                "type": "struct",
                "fields": [
                  {
                    "name": "Date",
                    "type": "date",
                    "nullable": false
                  },
                  {
                    "name": "EmployeeID",
                    "type": "string",
                    "nullable": false
                  },
                  {
                    "name": "EmployeeName",
                    "type": "string",
                    "nullable": false
                  },
                  {
                    "name": "AssignedOffice",
                    "type": "string",
                    "nullable": false
                  },
                  {
                    "name": "ActualOffice",
                    "type": "string",
                    "nullable": true
                  },
                  {
                    "name": "AttendanceStatus",
                    "type": "string",
                    "nullable": false
                  },
                  {
                    "name": "RecordedBy",
                    "type": "string",
                    "nullable": true
                  },
                  {
                    "name": "RecordedDateTime",
                    "type": "timestamp",
                    "nullable": true
                  },
                  {
                    "name": "Notes",
                    "type": "string",
                    "nullable": true
                  }
                ]
              }
            },
            "data": "@body('Get_Todays_Attendance_Records')?['value']"
          },
          "runAfter": {}
        },
        "Create_Parquet_File_Content": {
          "type": "Compose",
          "inputs": "@base64(string(outputs('Convert_To_Parquet_Format')))",
          "runAfter": {
            "Convert_To_Parquet_Format": [
              "Succeeded"
            ]
          }
        },
        "Create_File_In_SharePoint": {
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
              }
            },
            "method": "post",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/files",
            "queries": {
              "folderPath": "@parameters('exportFolderPath')",
              "name": "attendance_@{variables('ExportTimestamp')}.parquet",
              "queryParametersSingleEncoded": true
            },
            "body": "@outputs('Create_Parquet_File_Content')"
          },
          "runAfter": {
            "Create_Parquet_File_Content": [
              "Succeeded"
            ]
          },
          "runtimeConfiguration": {
            "contentTransfer": {
              "transferMode": "Chunked"
            }
          }
        },
        "Log_Export_Success": {
          "type": "Compose",
          "inputs": {
            "Status": "Export Completed",
            "FileName": "attendance_@{variables('ExportTimestamp')}.parquet",
            "RecordCount": "@length(body('Get_Todays_Attendance_Records')?['value'])",
            "ExportDate": "@variables('ExportDate')",
            "ExportTime": "@utcNow()"
          },
          "runAfter": {
            "Create_File_In_SharePoint": [
              "Succeeded"
            ]
          }
        }
      },
      "else": {
        "actions": {
          "Log_No_Records": {
            "type": "Compose",
            "inputs": {
              "Status": "No Records to Export",
              "ExportDate": "@variables('ExportDate')",
              "Message": "No attendance records found for today"
            },
            "runAfter": {}
          }
        }
      },
      "runAfter": {
        "Get_Todays_Attendance_Records": [
          "Succeeded"
        ]
      }
    },
    "Wait_For_Export_Completion": {
      "type": "Wait",
      "inputs": {
        "interval": {
          "count": 30,
          "unit": "Second"
        }
      },
      "runAfter": {
        "Check_If_Records_Exist": [
          "Succeeded"
        ]
      }
    },
    "Get_All_Attendance_Records_For_Deletion": {
      "type": "ApiConnection",
      "inputs": {
        "host": {
          "connection": {
            "name": "@parameters('$connections')['sharepointonline']['connectionId']"
          }
        },
        "method": "get",
        "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('dailyAttendanceListName')))}/items"
      },
      "runAfter": {
        "Wait_For_Export_Completion": [
          "Succeeded"
        ]
      },
      "runtimeConfiguration": {
        "paginationPolicy": {
          "minimumItemCount": 100000
        }
      }
    },
    "Delete_All_Attendance_Records": {
      "type": "Foreach",
      "foreach": "@body('Get_All_Attendance_Records_For_Deletion')?['value']",
      "actions": {
        "Delete_Attendance_Item": {
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
              }
            },
            "method": "delete",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('dailyAttendanceListName')))}/items/@{items('Delete_All_Attendance_Records')?['ID']}"
          },
          "runAfter": {}
        }
      },
      "runAfter": {
        "Get_All_Attendance_Records_For_Deletion": [
          "Succeeded"
        ]
      },
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 20
        }
      }
    },
    "Wait_After_Deletion": {
      "type": "Wait",
      "inputs": {
        "interval": {
          "count": 10,
          "unit": "Second"
        }
      },
      "runAfter": {
        "Delete_All_Attendance_Records": [
          "Succeeded"
        ]
      }
    },
    "Get_Active_Employees_For_Reset": {
      "type": "ApiConnection",
      "inputs": {
        "host": {
          "connection": {
            "name": "@parameters('$connections')['sharepointonline']['connectionId']"
          }
        },
        "method": "get",
        "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('employeeMasterListName')))}/items",
        "queries": {
          "$filter": "CurrentStatus eq 'Active'",
          "$orderby": "EmployeeID"
        }
      },
      "runAfter": {
        "Wait_After_Deletion": [
          "Succeeded"
        ]
      },
      "runtimeConfiguration": {
        "paginationPolicy": {
          "minimumItemCount": 100000
        }
      }
    },
    "Initialize_Next_Day_Date": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "NextDayDate",
            "type": "string",
            "value": "@{formatDateTime(addDays(utcNow(), 1), 'yyyy-MM-dd')}"
          }
        ]
      },
      "runAfter": {
        "Get_Active_Employees_For_Reset": [
          "Succeeded"
        ]
      }
    },
    "Create_Fresh_Attendance_Records": {
      "type": "Foreach",
      "foreach": "@body('Get_Active_Employees_For_Reset')?['value']",
      "actions": {
        "Create_New_Attendance_Record": {
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "connection": {
                "name": "@parameters('$connections')['sharepointonline']['connectionId']"
              }
            },
            "method": "post",
            "path": "/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sharePointSiteUrl')))}/tables/@{encodeURIComponent(encodeURIComponent(parameters('dailyAttendanceListName')))}/items",
            "body": {
              "Date": "@variables('NextDayDate')",
              "EmployeeID": "@items('Create_Fresh_Attendance_Records')?['EmployeeID']",
              "EmployeeName": "@items('Create_Fresh_Attendance_Records')?['EmployeeName']",
              "AssignedOffice": "@items('Create_Fresh_Attendance_Records')?['PrimaryOffice']",
              "AttendanceStatus": "Pending"
            },
            "retryPolicy": {
              "type": "exponential",
              "count": 4,
              "interval": "PT10S",
              "minimumInterval": "PT5S",
              "maximumInterval": "PT1H"
            }
          },
          "runAfter": {}
        }
      },
      "runAfter": {
        "Initialize_Next_Day_Date": [
          "Succeeded"
        ]
      },
      "runtimeConfiguration": {
        "concurrency": {
          "repetitions": 20
        }
      }
    },
    "Log_Reset_Completion": {
      "type": "Compose",
      "inputs": {
        "Status": "Reset Completed",
        "DeletedRecords": "@length(body('Get_All_Attendance_Records_For_Deletion')?['value'])",
        "CreatedRecords": "@length(body('Get_Active_Employees_For_Reset')?['value'])",
        "NextDayDate": "@variables('NextDayDate')",
        "CompletedAt": "@utcNow()"
      },
      "runAfter": {
        "Create_Fresh_Attendance_Records": [
          "Succeeded"
        ]
      }
    }
  },
  "outputs": {
    "ExportResetSummary": {
      "type": "Object",
      "value": {
        "ExportDate": "@variables('ExportDate')",
        "ExportTimestamp": "@variables('ExportTimestamp')",
        "RecordsExported": "@if(greater(length(body('Get_Todays_Attendance_Records')?['value']), 0), length(body('Get_Todays_Attendance_Records')?['value']), 0)",
        "RecordsDeleted": "@length(body('Get_All_Attendance_Records_For_Deletion')?['value'])",
        "RecordsCreated": "@length(body('Get_Active_Employees_For_Reset')?['value'])",
        "NextDayDate": "@variables('NextDayDate')",
        "CompletedAt": "@utcNow()"
      }
    }
  }
}
